# Minio / S3 configuration for images
MINIO_ENDPOINT=s3.example.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=personal-blog
MINIO_PUBLIC_URL=https://s3.example.com
MINIO_PRESIGNED_EXPIRY_SECONDS=3600

# Postgres database
DATABASE_URL=postgres://user:password@localhost:5432/personal_blog
